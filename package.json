{
  "name": "product-twin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/materialize_fixtures.mjs",
    "dev": "pnpm --filter @product-twin/web dev",
    "build": "pnpm --filter @product-twin/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @product-twin/web test:e2e",
    "schema:check": "pnpm --filter @product-twin/packaging-schema test && uv run --project apps/worker --frozen python scripts/check_schema_parity.py",
    "worker:test": "cd apps/worker && uv run pytest",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm schema:check && pnpm build",
    "fixtures:materialize": "node scripts/materialize_fixtures.mjs"
  }
}
