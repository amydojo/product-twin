# Browser-safe Supabase values. These may be exposed to the web bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only web values. Never prefix these with NEXT_PUBLIC_.
PRODUCT_TWIN_FIXTURE_MODE=true
PRODUCT_TWIN_WORKER_URL=http://localhost:7860
PRODUCT_TWIN_INTERNAL_SECRET=replace-with-at-least-32-random-bytes
ENABLE_DEBUG_VIEW=false

# Worker-only values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRODUCT_TWIN_WORKER_ID=product-twin-worker-local
PRODUCT_TWIN_BACKGROUND_PROVIDER=deterministic-fixture
PRODUCT_TWIN_TEMP_ROOT=
HF_HOME=.model-cache
BIREFNET_MODEL_ID=ZhengPeng7/BiRefNet_lite
BIREFNET_MODEL_REVISION=7838f1c3472f827cd8ce13ab5ccc2ce48077360f
